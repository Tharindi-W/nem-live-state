# The collector appends to these CSVs from Linux (GitHub Actions) and from
# Windows. Without a fixed EOL, the two platforms rewrite each other's lines
# and every run produces a whole-file diff.
* text=auto eol=lf
*.ps1 text eol=crlf
*.pdf binary

# latest.json is a snapshot rewritten in full every run. Never try to merge it --
# take whichever side is being applied; the next collection regenerates it anyway.
data/latest.json merge=ours
